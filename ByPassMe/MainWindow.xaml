<Window x:Class="ByPassMe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ByPassMe.Controls"
        Title="ByPassMe"
        Icon="/Assets/ByPassMe.ico"
        Width="1000" Height="630"
        MinWidth="640" MaxWidth="1000"
        MinHeight="420" MaxHeight="630"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <controls:AppBackdropControl/>

        <!-- На ноутбуках с маленьким экраном или укрупнением шрифтов Windows
             окно уменьшается, а содержимое пропорционально ужимается: ничего
             не обрезается и не уезжает за край. -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
        <Grid Width="976" Height="606" Margin="12,12,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="112"/>
            </Grid.ColumnDefinitions>

            <!-- Основной контент -->
            <ContentControl x:Name="MainContent" Grid.Column="0" Margin="0,0,12,0"/>

            <!-- Правая боковая панель: VPN / Обход / Настройки -->
            <Border x:Name="NavBar" Grid.Column="1" Visibility="Collapsed"
                    Background="{StaticResource NavShellBrush}"
                    CornerRadius="24"
                    Padding="6" BorderBrush="{StaticResource NavBorderBrush}" BorderThickness="1"
                    ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                </Border.Effect>
                <Grid x:Name="NavGrid" ClipToBounds="True">
                    <Border x:Name="NavIndicator" Background="{StaticResource NavIndicatorBrush}"
                            CornerRadius="18" HorizontalAlignment="Stretch"
                            VerticalAlignment="Top">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="NavIndicatorTransform"/>
                        </Border.RenderTransform>
                    </Border>
                    <UniformGrid Rows="3">
                        <Button x:Name="TabVpn" Style="{StaticResource NavTabButton}"
                                Click="OnTabVpn" Padding="4,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TabVpnIcon" Text="🔒" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="VPN" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                           LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBypass" Style="{StaticResource NavTabButton}"
                                Click="OnTabBypass" Padding="4,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TabBypassIcon" Text="🛡" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="Обход" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                           LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabSettings" Style="{StaticResource NavTabButton}"
                                Click="OnTabSettings" Padding="4,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TabSettingsIcon" Text="⚙" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="Настройки" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                           LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
        </Viewbox>
    </Grid>
</Window>

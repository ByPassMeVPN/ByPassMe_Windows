<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ByPassMe</AssemblyName>
    <RootNamespace>ByPassMe</RootNamespace>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Company>FlyFrogLLC</Company>
    <Product>ByPassMe</Product>
    <Description>ByPassMe — VPN (xray + sing-box TUN) + обход Б/С через VK TURN (rawtun)</Description>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Assets\ByPassMe.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <HUB_MOS_TOKEN Condition="'$(HUB_MOS_TOKEN)' == ''">@HUB_MOS_TOKEN@</HUB_MOS_TOKEN>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app-logo.png" />
    <Resource Include="Assets\ByPassMe.ico" />
    <Resource Include="Assets\Flags\*.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\bypass-direct-domains.json" CopyToOutputDirectory="PreserveNewest" Link="Assets\bypass-direct-domains.json" />
    <None Include="..\go_client\bypassclient.exe" Link="bypassclient.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\go_client\bypassclient.exe')" />
    <None Include="..\tools\wireguard.exe" Link="tools\wireguard.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\tools\wireguard.exe')" />
    <None Include="..\tools\wintun.dll" Link="tools\wintun.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\tools\wintun.dll')" />
    <None Include="..\tools\xray.exe" Link="tools\xray.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\tools\xray.exe')" />
    <None Include="..\tools\sing-box.exe" Link="tools\sing-box.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\tools\sing-box.exe')" />
    <None Include="..\tools\geosite.dat" Link="tools\geosite.dat" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\tools\geosite.dat')" />
    <None Include="..\tools\geoip.dat" Link="tools\geoip.dat" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\tools\geoip.dat')" />
    <None Include="..\tools\geosite-category-ru.srs" Link="tools\geosite-category-ru.srs" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\tools\geosite-category-ru.srs')" />
    <None Include="..\tools\geosite-category-gov-ru.srs" Link="tools\geosite-category-gov-ru.srs" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\tools\geosite-category-gov-ru.srs')" />
    <None Include="..\tools\geoip-ru.srs" Link="tools\geoip-ru.srs" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\tools\geoip-ru.srs')" />
  </ItemGroup>

  <Import Project="..\Secrets.props" Condition="Exists('..\Secrets.props')" />

</Project>

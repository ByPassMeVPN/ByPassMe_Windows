<UserControl x:Class="ByPassMe.Views.VpnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ByPassMe.Controls"
             xmlns:conv="clr-namespace:ByPassMe.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:PingDelayColorConverter x:Key="PingDelayColor"/>
        <Style x:Key="HiddenScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="8,4,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="VPN" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <Button x:Name="RefreshBtn" Grid.Column="1" Style="{StaticResource IconButton}"
                    Content="↻" Click="OnRefresh" ToolTip="Обновить серверы"/>
            <Button x:Name="KeyBtn" Grid.Column="2" Style="{StaticResource IconButton}"
                    Content="🔑" Click="OnShowSubscription" ToolTip="Подписка"/>
        </Grid>

        <controls:StatusBannerControl x:Name="StatusBanner" Grid.Row="1" Margin="0,0,0,10"/>
        <controls:JamWarningBannerControl x:Name="JamBanner" Grid.Row="2" Margin="0,0,0,10"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,8,0" Padding="16">
                <StackPanel VerticalAlignment="Center">
                    <Grid HorizontalAlignment="Center" Width="130" Height="130" Margin="0,8,0,12">
                        <Ellipse x:Name="OrbOuter" Width="130" Height="130" Fill="{StaticResource OrbOuterBrush}"/>
                        <Ellipse x:Name="OrbMiddle" Width="96" Height="96" Fill="{StaticResource OrbMiddleBrush}"/>
                        <Ellipse x:Name="OrbInner" Width="66" Height="66" Fill="{StaticResource OrbOffBrush}"/>
                        <TextBlock x:Name="OrbText" Text="OFF" FontSize="18" FontWeight="Black"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel x:Name="OrbServerPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,2,0,10"
                                Visibility="Collapsed">
                        <Border Width="26" Height="19" CornerRadius="4" Margin="0,0,8,0"
                                BorderBrush="#33000000" BorderThickness="0.75"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,26,19" RadiusX="4" RadiusY="4"/>
                            </Border.Clip>
                            <Image x:Name="OrbServerFlag" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock x:Name="OrbServerName" Text="" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                    </StackPanel>
                    <Button x:Name="ConnectBtn" Content="Подключить" Style="{StaticResource PrimaryButton}"
                            Click="OnToggleConnect" Margin="8,0,8,8"/>
                </StackPanel>
            </Border>

            <Border x:Name="ServerCardBorder" Grid.Column="1" Style="{StaticResource SectionCard}"
                    Margin="8,0,0,0" Padding="0" ClipToBounds="True">
                <Grid x:Name="ServerCardContent" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,10,14,6">
                        <TextBlock Text="Сервер" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button x:Name="PingBtn" Style="{StaticResource IconButton}"
                                Click="OnPingServers"
                                ToolTip="Пинг серверов (TCP, иначе ICMP)"
                                HorizontalAlignment="Right" Width="30" Height="30"
                                Padding="4" Margin="0,-4,0,-4">
                            <Viewbox Width="16" Height="16">
                                <!-- Material Design Icons: speedometer (Apache-2.0) -->
                                <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12C22,10.84 21.79,9.69 21.39,8.61L20,10A8,8 0 0,1 20,14A8,8 0 0,1 12,22A8,8 0 0,1 4,14A8,8 0 0,1 12,6C12.35,6 12.69,6.05 13,6.14L14.12,4.23C13.45,4.08 12.73,4 12,4V2M12.67,8.06L11.33,14.87L16.67,10.25L12.67,8.06Z"/>
                            </Viewbox>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ServersEmptyText" Grid.Row="1" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="14,8" Visibility="Collapsed" TextWrapping="Wrap"
                               VerticalAlignment="Top"/>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="ServerList"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 SelectionChanged="OnServerSelected"
                                 ClipToBounds="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource HiddenScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            ClipToBounds="True">
                                        <ScrollViewer Focusable="False"
                                                      Padding="0"
                                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid MinHeight="58" Background="Transparent" Cursor="Hand">
                                                    <Border x:Name="SelBar" Width="3" HorizontalAlignment="Left"
                                                            Background="{StaticResource PrimaryBrush}"
                                                            Visibility="Collapsed" Margin="4,8,0,8" CornerRadius="2"/>
                                                    <Border x:Name="Bd" Background="Transparent" Margin="0,2,0,2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#0A000000"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#145B588D"/>
                                                        <Setter TargetName="SelBar" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6,8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="28" CornerRadius="6"
                                                Margin="6,0,10,0" VerticalAlignment="Center"
                                                BorderBrush="#33000000" BorderThickness="0.75"
                                                Background="Transparent"
                                                SnapsToDevicePixels="True">
                                            <Border.Clip>
                                                <RectangleGeometry Rect="0,0,38,28" RadiusX="6" RadiusY="6"/>
                                            </Border.Clip>
                                            <Image Source="{Binding FlagImage}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Country}" FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Protocol}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0" Opacity="0.85"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Click="OnPingServer" Tag="{Binding}"
                                                ToolTip="Пинг сервера"
                                                VerticalAlignment="Center" Margin="0,0,12,0"
                                                MinWidth="52" Height="28" Padding="8,0"
                                                BorderThickness="0" Cursor="Hand"
                                                Background="{StaticResource SurfaceVariantBrush}"
                                                Foreground="{Binding PingMs, Converter={StaticResource PingDelayColor}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="{Binding PingText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{Binding PingMs, Converter={StaticResource PingDelayColor}}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="ByPassMe.Views.SubscriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подключение" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="24,20" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="🔑" FontSize="18" Margin="0,0,8,0"/>
            <TextBlock Text="Подключение" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </StackPanel>

        <TextBlock Text="Вставьте ссылку подписки. Сохраняется один раз."
                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   TextAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <Border Style="{StaticResource CompactLinkCard}">
            <StackPanel>
                <TextBlock Text="Ссылка подписки" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="UrlInput" Style="{StaticResource LinkTextBox}"/>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}"
                           FontSize="11" Visibility="Collapsed" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Button x:Name="ApplyBtn" Content="Применить"
                Style="{StaticResource CompactPrimaryButton}"
                HorizontalAlignment="Center" MinWidth="140" Margin="0,14,0,0"
                Click="OnApply"/>
    </StackPanel>
</Window>

<UserControl x:Class="ByPassMe.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Вкладка «Настройки» (вместо прежней «Логи») — как на Android и iPhone:
         работа в фоне, оформление, логи (открываются здесь же), версия. -->
    <Grid Margin="16,12,16,0">
        <!-- Список настроек -->
        <ScrollViewer x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Настройки" FontSize="18" FontWeight="Bold" Margin="4,0,0,12"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <!-- Работа в фоне -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Работа в фоне" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="4,0,0,4"/>
                        <TextBlock Text="Чтобы VPN и Обход поднимались сами после включения компьютера."
                                   FontSize="12" TextWrapping="Wrap" Margin="4,0,0,8"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <CheckBox x:Name="StartWithWindows" Margin="4,4" Click="OnStartWithWindows"
                                  VerticalContentAlignment="Center">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Запускать вместе с Windows" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="ByPassMe откроется при входе в систему" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="AutoConnect" Margin="4,8,4,4" Click="OnAutoConnect"
                                  VerticalContentAlignment="Center">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Подключаться автоматически" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="AutoConnectHint" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="При запуске включается то, что было включено последним"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Оформление -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Оформление" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="4,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
                            <ToggleButton x:Name="ThemeSystem" Content="Системная" Style="{StaticResource FilterChip}" Click="OnThemeSystem"/>
                            <ToggleButton x:Name="ThemeLight" Content="Светлая" Style="{StaticResource FilterChip}" Click="OnThemeLight"/>
                            <ToggleButton x:Name="ThemeDark" Content="Тёмная" Style="{StaticResource FilterChip}" Click="OnThemeDark"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,2">
                            <Ellipse x:Name="PalIndigo" Width="28" Height="28" Fill="#5B588D" Margin="0,0,12,0"
                                     Cursor="Hand" MouseLeftButtonDown="OnIndigo" ToolTip="Индиго"/>
                            <Ellipse x:Name="PalForest" Width="28" Height="28" Fill="#5F5D68" Margin="0,0,12,0"
                                     Cursor="Hand" MouseLeftButtonDown="OnForest" ToolTip="Графит"/>
                            <Ellipse x:Name="PalEspresso" Width="28" Height="28" Fill="#6D4C41"
                                     Cursor="Hand" MouseLeftButtonDown="OnEspresso" ToolTip="Эспрессо"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Логи -->
                <Border Style="{StaticResource SectionCard}" Cursor="Hand" MouseLeftButtonUp="OnOpenLogs"
                        Background="{StaticResource CardBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌨" FontSize="20" VerticalAlignment="Center" Margin="4,0,12,0"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Логи" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Посмотреть, скопировать или сохранить для поддержки" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="22" VerticalAlignment="Center" Margin="8,0,4,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="VersionText" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Экран логов (открывается из пункта «Логи») -->
        <Grid x:Name="LogsPanel" Visibility="Collapsed" Margin="-16,-12,-16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Style="{StaticResource IconButton}" Content="←" ToolTip="Назад"
                    HorizontalAlignment="Left" Margin="12,6,0,0" Click="OnCloseLogs"/>
            <ContentControl x:Name="LogsHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</UserControl>

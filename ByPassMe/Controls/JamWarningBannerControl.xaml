<UserControl x:Class="ByPassMe.Controls.JamWarningBannerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border CornerRadius="12" Padding="12,8" BorderThickness="1"
            Background="#33FFB300" BorderBrush="{StaticResource WarningBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="⚠" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                       Foreground="{StaticResource WarningBrush}"/>
            <TextBlock x:Name="HintText" Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="Возможно глушение интернета. Перейдите на вкладку «Обход»"/>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="ByPassMe.Controls.ConnectionStatsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" MinHeight="28">
    <!-- Только время сессии — скорость clash_api/NIC нестабильна -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="4,4,4,12">
        <TextBlock Text="⏱" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,6,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="DurationText" Text="00:00" FontSize="14" FontWeight="SemiBold"
                   FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"
                   VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
